  </article>

  <footer>
    <ul>
      <li>
        <h4>Tests</h4>
        <ul>
          <li>
            <a href="{{@root.base}}/">Add</a>
          </li>

          {{#if credentials}}
            <li>
              <a href="{{@root.base}}/browse/{{credentials.username}}">My tests</a>
            </li>
          {{/if}}

          <li>
            <a href="{{@root.base}}/browse">Latest</a>
          </li>
          <li>
            <a href="{{@root.base}}/popular">Popular</a>
          </li>
        </ul>
      </li>

      <li>
        <h4>Info</h4>
        <ul>
          <li>
            <a href="{{@root.base}}/faq">FAQ</a>
          </li>
          <li>
            <a href="{{@root.base}}/contributors">Contributors</a>
          </li>
          <li>
            <a href="https://benchmarkjs.com/">Benchmark.js</a>
          </li>
        </ul>
      </li>

      <li>
        <h4>Contact</h4>
        <ul>
          <li>
            <a href="https://github.com/FesterCluck/jsperf.com">GitHub</a>
          </li>
        </ul>
      </li>
    </ul>
  </footer>

  {{#if benchmark}}
    <script src="{{@root.base}}/public/_js/test.js"></script>
    <script>
      {{#each page.test}}
        ui.add(
          {{{ cleanJsString title }}},
          {
            'defer': {{#compare defer "y" operator="==="}}true{{ else }}false{{/compare}},
            'fn': {{{ cleanJsString code }}}
          }
        );
      {{/each}}

      {{#if page.setup}}
        Benchmark.prototype.setup = {{{ cleanJsString page.setup }}}
      {{/if}}
      {{#if page.teardown}}
        Benchmark.prototype.teardown = {{{ cleanJsString page.teardown }}}
      {{/if}}
    </script>

    {{{ page.initHTML }}}
  {{else}}
    {{#if mainJS}}
      <script>window.jsPerfBase = '{{@root.base}}';</script>
      <script src="{{@root.base}}/public/_vendor/jquery/jquery.min.js"></script>

      {{#if debug}}
        <script src="{{@root.base}}/public/_js/main.src.js"></script>
      {{else}}
        <script src="{{@root.base}}/public/_js/main.js"></script>
      {{/if}}
    {{/if}}
  {{/if}}
</body>
