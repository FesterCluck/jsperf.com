{{#if steps}}
  {{#unless nested}}<span class="bigo-then" aria-hidden="true">=</span>{{/unless}}
  <span class="bigo-steps{{#if nested}} bigo-nested{{/if}}" role="list" aria-label="What {{#if nested}}{{step}}{{else}}{{code}}{{/if}} is made of">
    {{#each steps}}
      {{#if steps}}
        <details class="bigo-step bigo-expandable" role="listitem">
          <summary title="{{step}}: {{label}}. Show what it is made of">
            <span class="bigo-graph bigo-mini{{#if ../space}} space-graph{{/if}} bigo-{{cls}}"><svg viewBox="0 0 56 28" aria-hidden="true"><use href="#{{curve}}"/></svg></span>
            <span class="bigo-step-name">{{step}}</span>
            <span class="bigo-sr">{{label}}</span>
          </summary>
          {{> bigo-steps space=../space nested=true}}
        </details>
      {{else}}
        <span class="bigo-step" role="listitem" title="{{step}}: {{label}}">
          <span class="bigo-graph bigo-mini{{#if ../space}} space-graph{{/if}} bigo-{{cls}}"><svg viewBox="0 0 56 28" aria-hidden="true"><use href="#{{curve}}"/></svg></span>
          <span class="bigo-step-name">{{step}}</span>
          <span class="bigo-sr">{{label}}</span>
        </span>
      {{/if}}
    {{/each}}
    {{#if moreSteps}}<span class="bigo-step bigo-more" role="listitem">+{{moreSteps}} more</span>{{/if}}
  </span>
{{/if}}
