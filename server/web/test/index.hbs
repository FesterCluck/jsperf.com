<hgroup>
  <h1>{{addCode page.title}}</h1>
  <h2>JavaScript performance comparison</h2>
</hgroup>

<p class="meta">
  {{#compare 1 page.revision}}
    Revision {{page.revision}} of this test case
  {{else}}
    Test case
  {{/compare}}
  created by {{formatAuthor page.author page.authorURL}}
  <time datetime="{{DatetoISOString page.published}}" pubdate>{{relativeDate page.published}}</time>

  {{#compare page.published page.updated operator="diffRelativeDate"}}
    and last updated <time datetime="{{DatetoISOString page.updated}}">{{relativeDate page.updated}}</time>
  {{/compare}}

  {{#if noIndex}}
    <strong>Not published yet!</strong>
    <form action="{{@root.base}}/{{page.slug}}/{{page.revision}}/publish" method="post" style="display:inline"><input type="hidden" name="crumb" value="{{crumb}}"><button type="submit">Publish</button></form>
    &middot;
    <a href="{{@root.base}}/{{page.slug}}{{#compare 1 page.revision}}/{{page.revision}}{{/compare}}/edit">Edit</a>
  {{/if}}
</p>

{{#if info}}
  <section>
    <h2>Info</h2>
    {{markdown info}}
  </section>
{{/if}}

{{#if hasPrep}}
  <section id="prep-code">
    <h2>Preparation code </h2>

    <pre><code>{{{page.initHTMLHighlighted}}}
    {{#if hasSetupOrTeardown}}
      {{#if page.initHTMLHighlighted}}<br>{{/if}}
      <span class="sc2">&lt;<span class="kw2">script</span>></span><br>
      {{#if page.setup.length}}
        Benchmark.<span class="me1">prototype</span>.<span class="me1">setup</span> <span class="sy0">=</span> <span class="kw2">function</span><span class="br0">(</span><span class="br0">)</span> <span class="br0">{</span><br>
          {{highlight (indent page.setup) "js"}}
        <br>  <span class="br0">}</span><span class="sy0">;</span>
        {{#if page.teardown.length}}
          <br><br>
        {{/if}}
      {{/if}}

      {{#if page.teardown.length}}
        Benchmark.<span class="me1">prototype</span>.<span class="me1">teardown</span> <span class="sy0">=</span> <span class="kw2">function</span><span class="br0">(</span><span class="br0">)</span> <span class="br0">{</span><br>
          {{highlight (indent page.teardown) "js"}}
        <br>  <span class="br0">}</span><span class="sy0">;</span>
      {{/if}}

      <br><span class="sc2">&lt;<span class="sy0">/</span><span class="kw2">script</span>></span>
    {{/if}}
    </code></pre>
  </section>

  {{#if stripped}}
    <section>
      <h2>Preparation code output</h2>
      <div class="user-output">
        {{stripped}}
      </div>
    </section>
  {{/if}}
{{/if}}

{{#if hasComplexity}}
  <svg width="0" height="0" style="position:absolute; width:0; height:0; overflow:hidden;" aria-hidden="true">
    <defs>
      <g id="bigo-guides" fill="none" stroke="#000" stroke-opacity="0.12" stroke-width="1">
        <path d="M5,23 L52,23"/>
        <path d="M5,25 Q18,16 52,15"/>
        <path d="M5,25 L52,4"/>
        <path d="M5,25 Q26,20 42,3"/>
        <path d="M5,25 Q16,25 25,3"/>
        <polyline points="5,2 5,25 52,25" stroke-opacity="0.35" stroke-width="1.2"/>
      </g>
      <g id="curve-o1">
        <use href="#bigo-guides"/>
        <path d="M5,23 L52,23" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="52" cy="23" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-ologn">
        <use href="#bigo-guides"/>
        <path d="M5,25 Q18,16 52,15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="52" cy="15" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-on">
        <use href="#bigo-guides"/>
        <path d="M5,25 L52,4" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="52" cy="4" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-onlogn">
        <use href="#bigo-guides"/>
        <path d="M5,25 Q26,20 42,3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="42" cy="3" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-on2">
        <use href="#bigo-guides"/>
        <path d="M5,25 Q16,25 25,3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="25" cy="3" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-on3">
        <use href="#bigo-guides"/>
        <path d="M5,25 Q11,25 17,3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="17" cy="3" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-higher">
        <use href="#bigo-guides"/>
        <path d="M5,25 Q8,25 11,3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="11" cy="3" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-ologn2">
        <use href="#bigo-guides"/>
        <path d="M5,25 Q24,15 52,9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="52" cy="9" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-onlogn2">
        <use href="#bigo-guides"/>
        <path d="M5,25 Q21,22 33,3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="33" cy="3" r="2.3" fill="currentColor"/>
      </g>
      <g id="curve-oexp">
        <use href="#bigo-guides"/>
        <path d="M5,25 Q6,25 8,3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="8" cy="3" r="2.3" fill="currentColor"/>
        <text x="30" y="14" text-anchor="middle" font-size="12" font-weight="bold" fill="currentColor">2ⁿ</text>
      </g>
      <g id="icon-space">
        <rect x="1" y="1" width="10" height="3" rx="1" fill="currentColor"/>
        <rect x="1" y="4.5" width="10" height="3" rx="1" fill="currentColor" opacity=".7"/>
        <rect x="1" y="8" width="10" height="3" rx="1" fill="currentColor" opacity=".4"/>
      </g>
      <g id="curve-unknown">
        <use href="#bigo-guides"/>
        <text x="29" y="21" text-anchor="middle" font-size="20" font-weight="bold" fill="currentColor">?</text>
      </g>
    </defs>
  </svg>
{{/if}}

<section id="runner">
  <h2>Test runner</h2>
  <p id="firebug"><strong>Warning! For accurate results, please disable Firebug before running the tests. <a href="{{@root.base}}/faq#firebug-warning">(Why?)</a></strong></p>
  <p id="java"><strong>Java applet disabled.</strong></p>
  <p id="status"><noscript><strong>To run the tests, please <a href="http://www.enable-javascript.com/">enable JavaScript</a> and reload the page.</strong></noscript></p>
  <div id="controls"><button id="run" type="button"></button></div>
  <table id="test-table">
  <caption>Testing in {{userAgent}}</caption>
    <thead>
      <tr>
        <th colspan="2">Test</th>
        <th title="Operations per second (higher is better)">Ops/sec</th>
      </tr>
    </thead>
    <tbody>
      {{#each page.test}}
        <tr>
          <th scope="row" id="title-{{inc @index}}">
            <div>
              {{addCode title}}
              {{#if @root.pageInit}}
                <span id="extra-{{inc @index}}"></span>
              {{/if}}
            </div>
          </th>
          <td class="code">
            <pre><code>{{#compare defer "y" operator="==="}}<strong class="col1">// async test</strong><br>{{/compare}}{{highlight code "js"}}</code></pre>
          </td>
          <td id="results-{{inc @index}}" class="results">pending…</td>
        </tr>
        {{#with complexityView}}
          {{#each calls}}
            <tr class="complexity-row{{#if end}} complexity-end{{/if}}{{#if ../unknown}} complexity-unknown{{/if}}">
              <th scope="row"><code>{{code}}</code></th>
              <td class="complexity-breakdown">
                <div class="bigo-line">
                  <span class="bigo-graph bigo-{{cls}}" title="{{label}}"><svg viewBox="0 0 56 28" aria-hidden="true"><use href="#{{curve}}"/></svg></span>
                  {{> bigo-steps}}
                </div>
              </td>
              {{#if @first}}
                <td class="complexity-total" rowspan="{{../rows}}">
                  <span class="bigo-graph bigo-{{../overall.cls}}" title="{{../overall.label}}"><svg viewBox="0 0 56 28" aria-hidden="true"><use href="#{{../overall.curve}}"/></svg></span>
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr class="complexity-row complexity-end{{#if unknown}} complexity-unknown{{/if}}">
              <th scope="row"><em>no function calls</em></th>
              <td class="complexity-breakdown"></td>
              <td class="complexity-total">
                <span class="bigo-graph bigo-{{overall.cls}}" title="{{overall.label}}"><svg viewBox="0 0 56 28" aria-hidden="true"><use href="#{{overall.curve}}"/></svg></span>
              </td>
            </tr>
          {{/each}}
          {{#if more}}
            <tr class="complexity-row complexity-end">
              <th scope="row"><em>+{{more}} more</em></th>
              <td class="complexity-breakdown"></td>
            </tr>
          {{/if}}
          {{#with space}}
            {{#each items}}
              <tr class="complexity-row space-row{{#if end}} complexity-end{{/if}}">
                <th scope="row">{{#if code}}<code>{{code}}</code>{{/if}}</th>
                <td class="complexity-breakdown">
                  <div class="bigo-line">
                    <span class="bigo-graph space-graph bigo-{{cls}}" title="{{label}}"><svg class="space-icon" viewBox="0 0 12 12" aria-hidden="true"><use href="#icon-space"/></svg><svg viewBox="0 0 56 28" aria-hidden="true"><use href="#{{curve}}"/></svg></span>
                    {{> bigo-steps space=true}}
                  </div>
                </td>
                {{#if @first}}
                  <td class="complexity-total" rowspan="{{../rows}}">
                    <span class="bigo-graph space-graph bigo-{{../overall.cls}}" title="{{../overall.label}}"><svg class="space-icon" viewBox="0 0 12 12" aria-hidden="true"><use href="#icon-space"/></svg><svg viewBox="0 0 56 28" aria-hidden="true"><use href="#{{../overall.curve}}"/></svg></span>
                  </td>
                {{/if}}
              </tr>
            {{else}}
              <tr class="complexity-row space-row complexity-end">
                <th scope="row"></th>
                <td class="complexity-breakdown"></td>
                <td class="complexity-total">
                  <span class="bigo-graph space-graph bigo-{{overall.cls}}" title="{{overall.label}}"><svg class="space-icon" viewBox="0 0 12 12" aria-hidden="true"><use href="#icon-space"/></svg><svg viewBox="0 0 56 28" aria-hidden="true"><use href="#{{overall.curve}}"/></svg></span>
                </td>
              </tr>
            {{/each}}
          {{/with}}
        {{/with}}
      {{/each}}
    </tbody>
  </table>


  {{!-- the preparation code and the tests run in here, in a sandbox without access to this site (see the frame route) --}}
  <iframe id="test-frame" class="{{#unless page.initHTML}}empty{{/unless}}" src="{{@root.base}}/{{page.slug}}/{{page.revision}}/frame" sandbox="allow-scripts" referrerpolicy="no-referrer" title="Where the tests run"></iframe>

  {{#compare page.maxRev 2}}
    <p>You can <a href="{{@root.base}}/{{page.slug}}{{#compare 1 page.revision}}/{{page.revision}}{{/compare}}/edit" rel="nofollow">edit these tests or add even more tests to this page</a> by appending <code>/edit</code> to the URL.</p>
  {{/compare}}
</section>

{{#compare 1 page.maxRev}}
  <section id="revisions">
    <h2>Revisions</h2>
    <p>You can <a href="{{@root.base}}/{{page.slug}}{{#compare 1 page.revision}}/{{page.revision}}{{/compare}}/edit" rel="nofollow">edit these tests or add even more tests to this page</a> by appending <code>/edit</code> to the URL.</p>
    <ul>
      {{#each page.revisions}}
        {{#compare visible "y" operator="==="}}
        {{!-- TODO: add "or admin session" --}}
          <li {{#compare revision ../page.revision operator="==="}}class="current"{{/compare}}>
            <a href="{{@root.base}}/{{../page.slug}}{{#compare 1 revision}}/{{revision}}{{/compare}}">Revision {{revision}}</a>: published {{formatAuthor author authorURL}}
            <time datetime="{{DatetoISOString published}}" pubdate>
              {{relativeDate published}}
            </time>
            {{#compare published updated operator="diffRelativeDate"}}
              and last updated
              <time datetime="{{DatetoISOString updated}}">
                {{relativeDate updated}}
              </time>
            {{/compare}}
          </li>
        {{/compare}}
      {{/each}}
    </ul>
  </section>
{{/compare}}

<section id="comments">
  <h1>{{pluralize page.comments.length "Comment"}}</h1>

  <div id="comments-wrapper">
    {{#each page.comments}}
      <article id="comment-{{inc @index}}" {{#compare ../page this operator="isOwner"}}class="owner"{{/compare}}>
        <p class="meta">
          {{formatAuthor author authorURL true}}

          {{#compare ../page this operator="isOwner"}}
            (revision owner)
          {{/compare}}

          commented <time datetime="{{DatetoISOString published}}" pubdate>{{relativeDate published}}</time>: <a href="#comment-{{inc @index}}" title="Permanent link to this comment">∞</a>
        </p>

        <div>{{markdown content}}</div>
      </article>
    {{/each}}
  </div>

  {{#if credentials}}
    <form action="{{@root.base}}/{{page.slug}}{{#compare 1 page.revision}}/{{page.revision}}{{/compare}}#comment-form" method="post" id="comment-form">
      <input type="hidden" name="crumb" value="{{crumb}}">
      <fieldset>
        <h2>Add a comment</h2>
        <div>
          <label for="author">Name <em title="This field is required">*</em> </label>
          <input type="text" name="author" id="author" required
            {{#if author}}
              value="{{author}}"
            {{else}}
              value="{{credentials.displayName}}"
            {{/if}}
          >
          {{#if authorError}} {{authorError}}{{/if}}
        </div>
        <div>
          <label for="authorEmail">Email <em title="This field is required">*</em> </label>
          {{#unless mailError}}<label class="inline">{{/unless}}
            <input type="email" name="authorEmail" id="authorEmail" required
              {{#if authorEmail}}
                value="{{authorEmail}}"
              {{else}}
                value="{{credentials.email}}"
              {{/if}}
            >
            {{#if authorEmailError}} {{authorEmailError}}{{else}}(won’t be displayed)</label>{{/if}}
        </div>
        <div>
          <label for="authorURL">URL </label>
          <input type="url" name="authorURL" id="authorURL"
            {{#if authorURL}}
              value="{{authorURL}}"
            {{else}}
              value=""
            {{/if}}
          >
          {{#if authorURLError}} {{authorURLError}}{{/if}}
        </div>
        <div>
          <label for="message">Message <em title="This field is required">*</em> <span>Markdown syntax is allowed</span></label>
          <textarea name="message" id="message" maxlength="{{mediumTextLength}}" required>{{#if message}}{{message}}{{/if}}</textarea>
          {{#if messageError}} {{messageError}}{{/if}}
        </div>
        <div class="buttons">
          <input type="submit" class="submit" value="Add comment">
        </div>
      </fieldset>
    </form>
  {{else}}
      <a class="login" href="{{@root.base}}/login">Log in to Edit Test Cases</a> or <a href="{{@root.base}}/register">register</a>
  {{/if}}
</section>
