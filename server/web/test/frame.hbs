<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{page.title}}</title>
  <style>body { margin: 8px; font: 14px/1.4 sans-serif; }</style>
</head>
<body>
  <script>{{{runner}}}</script>
  <script>
    {{#each page.test}}
      ui.add(
        {{{ cleanJsString title }}},
        {
          'defer': {{#compare defer "y" operator="==="}}true{{ else }}false{{/compare}},
          'fn': {{{ cleanJsString code }}}
        }
      );
    {{/each}}

    {{#if page.setup}}
      Benchmark.prototype.setup = {{{ cleanJsString page.setup }}}
    {{/if}}
    {{#if page.teardown}}
      Benchmark.prototype.teardown = {{{ cleanJsString page.teardown }}}
    {{/if}}
  </script>

  {{{ page.initHTML }}}
</body>
</html>
