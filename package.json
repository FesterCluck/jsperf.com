{
  "name": "jsperf.com",
  "version": "2.0.0",
  "description": "jsPerf aims to provide an easy way to create and share test cases, comparing the performance of different JavaScript snippets by running benchmarks",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:vendor && gulp",
    "build:vendor": "node scripts/copy-vendor.js",
    "lint": "eslint .",
    "start": "node server.js",
    "test": "lab -t 100 -c -r console -o stdout -r lcov -o lcov.info -r html -o coverage.html test/unit",
    "test-e2e": "playwright test",
    "watch": "nodemon -e js,hbs server.js",
    "test-e2e:install": "playwright install chromium"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:FesterCluck/jsperf.com.git"
  },
  "keywords": [
    "jsperf"
  ],
  "bugs": {
    "url": "https://github.com/FesterCluck/jsperf.com/issues"
  },
  "license": "MIT",
  "homepage": "https://github.com/FesterCluck/jsperf.com",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/catbox": "^12.1.1",
    "@hapi/catbox-redis": "^7.1.0",
    "@hapi/cookie": "^12.0.1",
    "@hapi/crumb": "^9.0.1",
    "@hapi/glue": "^9.0.1",
    "@hapi/hapi": "^21.4.12",
    "@hapi/hoek": "^11.0.7",
    "@hapi/inert": "^7.1.3",
    "@hapi/scooter": "^8.0.0",
    "@hapi/vision": "^7.0.3",
    "@hapi/yar": "^11.0.3",
    "acorn": "^8.19.0",
    "confidence": "^5.0.1",
    "dotenv": "^18.0.9",
    "font-awesome": "^4.7.0",
    "handlebars": "^4.0.12",
    "hapi-pino": "^13.0.0",
    "highlight.js": "^11.11.1",
    "joi": "^18.3.1",
    "jquery": "^3.7.1",
    "jsesc": "^3.1.0",
    "markdown-it": "^15.0.3",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qs": "^6.17.1",
    "sanitize-html": "^2.18.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@hapi/code": "^9.0.3",
    "@hapi/lab": "^26.0.1",
    "@playwright/test": "^1.64.1",
    "ajv": "^6.12.4",
    "benchmark": "2.1.4",
    "cheerio": "^1.2.0",
    "eslint": "^10.14.0",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-rename": "^1.4.0",
    "lodash": "^4.17.11",
    "neostandard": "^0.14.1",
    "nodemon": "^3.1.14",
    "platform": "^1.3.5",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
